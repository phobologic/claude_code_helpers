#!/usr/bin/env python3
# Planning helper for /run-tickets: resolve a ticket set and its dependency graph.
"""
Usage: run-tickets-plan [--include-in-progress] <epic-id> | <ticket-id> [ticket-id ...]

Resolves the input to a set of runnable tickets and prints one JSON object:

  mode              "epic" or "ids"
  epic_id           the epic when mode == "epic", else null
  shared_parent     the parent every runnable ticket shares, or null if mixed/none
  integration       where to integrate: {branch, exists, reason, ahead_of_main,
                    behind_main}. branch is epic/<id> when the tickets belong to
                    an epic that has (or, in epic mode, will get) a branch; null
                    means cut a fresh run/<stamp> from main
  tickets           runnable tickets, topologically ordered:
                      {id, title, priority, parent, tags, deps, has_ac, files, reviewed}
                    deps lists only in-set tickets this one waits on. reviewed is
                    {sha, human_checks} when the ticket's notes end in a passing review
                    of exactly its ticket/<id> branch tip (an earlier run reviewed it
                    but did not merge it), else null; the workflow sends such a ticket
                    straight to merge
  excluded          [{id, title, reason}] for tickets that will not run
  decisions         [{id, title, tags, outside_run, downstream}] for tickets tagged
                    decision: they wait on the owner's call, and so does everything
                    downstream. outside_run marks an open decision ticket that is not
                    in the input set but that input tickets wait on
  decision_candidates
                    [{id, title, phrase}] for runnable tickets whose description reads
                    like a decision (decide, design call, untuned, ...). A hint for the
                    lead to judge, not a verdict
  cycles            dependency cycles among the input tickets (each a list of ids)
  overlaps          [{file, tickets}] for files named by 2+ tickets that have no
                    dependency path between them. The workflow never runs two tickets
                    that name the same file at once, so these take turns
  unannotated       ids of runnable tickets with no **Files**: line
  large             [{id, title, ac_count, dependents}] for tickets with more than 6
                    acceptance criteria: likely too big to settle within the rework
                    cap, and everything downstream stalls if one blocks
  stats             {ready_now, longest_chain, max_width}

Tickets are excluded when closed, when they are epics, when in_progress (unless
--include-in-progress, used to resume a stopped run), when tagged needs-human
(a gate a person must clear) or decision (a choice the owner has not made yet),
when they wait on an open ticket outside the set, or when they sit downstream
of an excluded ticket.

Also reports `setup_warnings` about the repo itself, such as a package.json with
no node_modules/ entry in .worktreelinks (worktrees would lack dependencies), or
no permission rule allowing `git merge` (the merge step can be refused).
"""

import json
import os
import re
import subprocess
import sys

AC_RE = re.compile(
    r"^\s*(#+\s*acceptance criteria|\*\*acceptance criteria\*\*|acceptance criteria:)",
    re.IGNORECASE | re.MULTILINE,
)
FILES_RE = re.compile(r"\*\*Files\*\*\s*:?\s*(.+)")

# Wording that marks a ticket whose outcome is a choice rather than a fix. Only a
# hint: the lead reads each match and every other ticket, and decides whether the
# owner must be asked. Phrases, not bare stems, so code that "decides whether" or a
# settled "decision D1" does not match.
DECISION_RE = re.compile(
    r"\bdecid(?:e|ing) (?:whether|which|how|what|if|between|on|during|after|later|the)\b"
    r"|\bworth (?:a decision|deciding)\b|\bneeds? (?:a|an|the owner'?s?) (?:decision|call)\b"
    r"|\bdesign (?:call|question|decision)\b|\buntuned\b|\bto be decided\b"
    r"|\bjudge?ment call\b|\bopen question\b|\b(?:owner|human)'?s? (?:call|decision|approval|sign-off)\b",
    re.IGNORECASE,
)

# tk show appends these after the description; their text is other tickets' or earlier runs'.
TRAILING_SECTIONS_RE = re.compile(r"^## (?:Notes|Blockers|Blocking|Children|Linked)\b.*$", re.MULTILINE)

# tk keeps notes in the ticket file under ## Notes, each after a **<UTC timestamp>** line;
# tk show prints the sections after that one itself.
NOTES_RE = re.compile(r"^## Notes\s*$(.*?)(?=^## (?:Blockers|Blocking|Children|Linked)\b|\Z)", re.MULTILINE | re.DOTALL)
NOTE_STAMP_RE = re.compile(r"^\*\*\d{4}-\d\d-\d\dT[\d:.]+Z?\*\*\s*$", re.MULTILINE)
# Notes that say what state the ticket's work is in. A passing review is only current
# while none of these follow it: new work, a new verdict, or changed criteria.
PIPELINE_NOTE_RE = re.compile(
    r"^(?:\*\*Review round \d+\*\*|\*\*Implementer round|AC VERIFICATION:|ACCEPTANCE CRITERIA:|Owner decision)")
PASSING_REVIEW_RE = re.compile(r"^\*\*Review round \d+\*\*:\s*(?:CLEAN|FINDINGS)\b")
# The reviewer's form, "<integration branch>...ticket/<id> at <sha>". Free-form text after
# the label can name other commits (where the branch merged), so nothing looser is trusted.
REVIEWED_AT_RE = re.compile(r"^\*\*Diff reviewed\*\*:\s*\S+\.\.\.ticket/\S+ at ([0-9a-f]{7,40})\b", re.MULTILINE)
# Verifiers write "2. <criterion>: met, NEEDS A PERSON: <check>. Code: ..." or put the
# NEEDS A PERSON line on its own, sometimes with a qualifier before the colon.
CRITERION_MET_RE = re.compile(r"^\s*(?:[-*]|\d+[.)])?\s*(.+?):\s*met\b")
NEEDS_PERSON_LABEL_RE = re.compile(r"NEEDS A PERSON(?:\s*\([^)]*\))?\s*:\s*(.*)")

# Words people put in a **Files** line that are not paths. Paths become in-run locks,
# so prose must not.
NOT_PATHS = {"n/a", "na", "tbd", "none", "etc", "e.g", "i.e", "various", "see"}

def tk(*args):
    out = subprocess.run(["tk", *args], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"run-tickets-plan: tk {' '.join(args)} failed: {out.stderr.strip()}")
    return out.stdout


def query(jq_filter):
    return [json.loads(line) for line in tk("query", jq_filter).splitlines() if line.strip()]


def meta(ticket_id):
    rows = query(f'select(.id=="{ticket_id}")')
    if not rows:
        sys.exit(f"run-tickets-plan: no ticket with id {ticket_id}")
    return rows[0]


def title_and_body(ticket_id):
    text = tk("show", ticket_id)
    # Drop the frontmatter block, then take the first H1 as the title.
    body = re.sub(r"\A---\n.*?\n---\n", "", text, count=1, flags=re.DOTALL)
    m = re.search(r"^# (.+)$", body, re.MULTILINE)
    return (m.group(1).strip() if m else ticket_id), body


def path_like(part):
    """A token that names a file or directory: has a slash or an extension, and is not prose."""
    if part.lower().rstrip(".") in NOT_PATHS or part.endswith("."):
        return False
    if not re.fullmatch(r"[\w.\-/@+]+", part):
        return False
    return "/" in part or bool(re.search(r"\w\.[A-Za-z0-9]{1,8}$", part))


def parse_files(body):
    files = []
    for line in FILES_RE.findall(body):
        for part in re.split(r"[,\s]+", line):
            part = part.strip("`*()[];")
            part = re.sub(r":\d[\d\-,]*$", "", part)  # strip :42 or :42-47
            part = re.sub(r"^\./", "", part)
            if path_like(part):
                files.append(part)
    return sorted(set(files))


def description(body):
    """The ticket's own text: above notes and linked tickets, without its **Files** lines."""
    text = TRAILING_SECTIONS_RE.split(body, maxsplit=1)[0]
    return "\n".join(line for line in text.splitlines() if not FILES_RE.search(line))


def decision_phrase(body):
    """The sentence around the first decision-like wording in the description, or None."""
    text = description(body)
    m = DECISION_RE.search(text)
    if not m:
        return None
    start = max(text.rfind(".", 0, m.start()), text.rfind("\n", 0, m.start())) + 1
    ends = [i for i in (text.find(".", m.end()), text.find("\n", m.end())) if i != -1]
    end = min(ends) if ends else len(text)
    phrase = " ".join(text[start:end + 1].split()).lstrip("# ")
    return phrase if len(phrase) <= 200 else phrase[:197] + "..."


LARGE_AC_COUNT = 6


def ac_count(body):
    """Number of list items under the acceptance criteria heading, up to the next heading."""
    m = AC_RE.search(body)
    if not m:
        return 0
    count = 0
    for line in body[m.end():].splitlines()[1:]:
        stripped = line.strip()
        if stripped.startswith("#") or (stripped.startswith("**") and not stripped.startswith("**-")):
            break
        if re.match(r"^([-*+]|\d+[.)])\s+", stripped):
            count += 1
    return count


def notes(body):
    """The ticket's notes from tk show's output, oldest first, each without its timestamp line."""
    m = NOTES_RE.search(body)
    if not m:
        return []
    return [n.strip() for n in NOTE_STAMP_RE.split(m.group(1))[1:] if n.strip()]


def passing_review(note_list):
    """(reviewed sha, human checks) when the ticket's state is a passing review, else None.

    The human checks are the NEEDS A PERSON lines of the AC pass the review
    followed, in the form the workflow reports them.
    """
    pipeline = [n for n in note_list if PIPELINE_NOTE_RE.match(n)]
    if not pipeline or not PASSING_REVIEW_RE.match(pipeline[-1]):
        return None
    at = REVIEWED_AT_RE.search(pipeline[-1])
    if not at:
        return None
    acs = [n for n in pipeline if n.startswith("AC VERIFICATION:")]
    checks = []
    if acs and acs[-1].startswith("AC VERIFICATION: PASS"):
        for line in acs[-1].splitlines():
            i = line.find("NEEDS A PERSON")
            if i < 0:
                continue
            label = NEEDS_PERSON_LABEL_RE.match(line[i:])
            what = (label.group(1) if label else line[i:]).split(". Code:")[0].strip()
            crit = CRITERION_MET_RE.match(line[:i])
            checks.append(f"{crit.group(1)}: {what}" if crit else what)
    return at.group(1), checks


def reviewed(ticket_id, body):
    """{sha, human_checks} when the last passing review saw exactly ticket/<id>'s tip, else None."""
    found = passing_review(notes(body))
    if not found:
        return None
    sha, checks = found
    tip = git("rev-parse", "--verify", "--quiet", f"refs/heads/ticket/{ticket_id}")
    if not tip or not tip.startswith(sha):
        return None
    return {"sha": sha, "human_checks": checks}


def allows_git_merge(rules):
    """True when one of these permission allow rules covers `git merge ...`."""
    for rule in rules:
        m = re.fullmatch(r"Bash(?:\((.*)\))?", str(rule).strip())
        if not m:
            continue
        body = (m.group(1) if m.group(1) is not None else "*").strip()
        if body.endswith(":*"):
            prefix = body[:-2]
        elif body.endswith("*"):
            prefix = body[:-1]
        else:
            continue  # an exact command, not a prefix
        if prefix.strip() in ("", "git", "git merge"):
            return True
    return False


def allow_rules(root):
    """permissions.allow from the project's and the user's settings files."""
    rules = []
    for path in (os.path.join(root, ".claude", "settings.json"), os.path.join(root, ".claude", "settings.local.json"),
                 os.path.expanduser("~/.claude/settings.json"), os.path.expanduser("~/.claude/settings.local.json")):
        try:
            with open(path) as f:
                rules += (json.load(f).get("permissions") or {}).get("allow") or []
        except (OSError, ValueError, AttributeError):
            continue
    return rules


def setup_warnings():
    """Repo-level problems that would break agents working in fresh worktrees."""
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if out.returncode != 0:
        return []
    root = out.stdout.strip()

    def entries(name):
        path = os.path.join(root, name)
        if not os.path.exists(path):
            return set()
        with open(path) as f:
            return {line.strip().rstrip("/") for line in f if line.strip() and not line.startswith("#")}

    shared = entries(".worktreelinks") | entries(".worktreeinclude")
    warnings = []
    if os.path.exists(os.path.join(root, "package.json")) and "node_modules" not in shared:
        warnings.append(
            "package.json exists but node_modules is not in .worktreelinks, so worktrees have no "
            "dependencies: tests, type checks, and commit hooks will fail or pick up the wrong tool "
            "versions. Add a `node_modules/` line to .worktreelinks.")
    if not allows_git_merge(allow_rules(root)):
        warnings.append(
            "No permission allow rule covers `git merge`. In auto mode the permission classifier judges every "
            "merge step's git commands and can refuse one, which halts merging for the rest of the run. Add "
            "`Bash(git merge:*)` to permissions.allow in .claude/settings.local.json.")
    return warnings


def git(*args):
    out = subprocess.run(["git", *args], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def integration_branch(mode, epic_id, shared_parent):
    """Where this run should integrate.

    Tickets that belong to an epic go onto that epic's branch when it exists,
    because an unmerged epic branch is where the code they touch lives. Only a
    set of tickets with no epic branch gets a fresh branch cut from main.
    """
    epic = epic_id if mode == "epic" else shared_parent
    if epic:
        branch = f"epic/{epic}"
        if git("show-ref", "--verify", "--quiet", f"refs/heads/{branch}") is not None:
            ahead = git("rev-list", "--count", f"main..{branch}")
            behind = git("rev-list", "--count", f"{branch}..main")
            return {"branch": branch, "exists": True, "reason": f"branch of epic {epic}",
                    "ahead_of_main": int(ahead or 0), "behind_main": int(behind or 0)}
        if mode == "epic":
            return {"branch": branch, "exists": False, "reason": f"new branch for epic {epic}, cut from main",
                    "ahead_of_main": 0, "behind_main": 0}
    return {"branch": None, "exists": False,
            "reason": "no epic branch for these tickets; create run/<stamp> from main",
            "ahead_of_main": 0, "behind_main": 0}


def find_cycles(ids, deps):
    cycles, state, stack = [], {}, []

    def visit(n):
        state[n] = "open"
        stack.append(n)
        for d in deps[n]:
            if state.get(d) == "open":
                cycles.append(stack[stack.index(d):] + [d])
            elif d not in state:
                visit(d)
        stack.pop()
        state[n] = "done"

    for n in ids:
        if n not in state:
            visit(n)
    return cycles


def tag_list(m):
    tags = m.get("tags") or []
    if isinstance(tags, str):
        tags = [t.strip() for t in tags.strip("[]").split(",") if t.strip()]
    return tags


def all_ancestors(n, deps):
    seen, stack = set(), list(deps.get(n, []))
    while stack:
        d = stack.pop()
        if d not in seen:
            seen.add(d)
            stack.extend(deps.get(d, []))
    return seen


def main(argv):
    include_in_progress = "--include-in-progress" in argv
    args = [a for a in argv if a != "--include-in-progress"]
    if not args:
        sys.exit(__doc__)

    mode, epic_id = "ids", None
    if len(args) == 1 and meta(args[0]).get("type") == "epic":
        mode, epic_id = "epic", args[0]
        candidates = [r["id"] for r in query(f'select(.parent=="{epic_id}")')]
    else:
        candidates = args

    info, excluded = {}, []
    for tid in candidates:
        m = meta(tid)
        title, body = title_and_body(tid)
        status = m.get("status")
        reason = None
        if status == "closed":
            reason = "closed"
        elif m.get("type") == "epic":
            reason = "is an epic (run it separately)"
        elif status == "in_progress" and not include_in_progress:
            reason = "in_progress (another run may own it; pass --include-in-progress to resume)"
        if reason:
            excluded.append({"id": tid, "title": title, "reason": reason})
            continue
        tags = tag_list(m)
        info[tid] = {
            "id": tid,
            "title": title,
            "tags": tags,
            "needs_human": "needs-human" in tags,
            "decision": "decision" in tags,
            "decision_phrase": decision_phrase(body),
            "priority": int(m.get("priority", 2)),
            "parent": m.get("parent") or None,
            "raw_deps": m.get("deps", []),
            "has_ac": bool(AC_RE.search(body)),
            "ac_count": ac_count(body),
            "files": parse_files(body),
            "reviewed": reviewed(tid, body),
        }

    # Split deps into in-set edges and external blockers. An external blocker tagged
    # decision is still a question for the owner, so it is reported like one.
    blocked_by, outside_decisions = {}, {}
    for t in info.values():
        t["deps"] = []
        for d in t["raw_deps"]:
            if d in info:
                t["deps"].append(d)
                continue
            dm = meta(d)
            if dm.get("status") != "closed":
                blocked_by.setdefault(t["id"], []).append(d)
                if "decision" in tag_list(dm):
                    outside_decisions.setdefault(d, []).append(t["id"])

    deps = {tid: t["deps"] for tid, t in info.items()}
    cycles = find_cycles(list(info), deps)
    in_cycle = {n for c in cycles for n in c}

    # Drop externally blocked and cyclic tickets, then everything downstream.
    dropped = {tid: f"waits on open ticket(s) outside this run: {', '.join(ds)}"
               for tid, ds in blocked_by.items()}
    dropped.update({tid: "part of a dependency cycle" for tid in in_cycle})
    dropped.update({tid: "tagged needs-human: a person must do this one; run its dependents after it closes"
                    for tid, t in info.items() if t["needs_human"]})
    dropped.update({tid: "tagged decision: waits on the owner's call"
                    for tid, t in info.items() if t["decision"] and tid not in dropped})
    decision_ids = [tid for tid, t in info.items() if t["decision"]]
    changed = True
    while changed:
        changed = False
        for tid, ds in deps.items():
            if tid not in dropped:
                bad = [d for d in ds if d in dropped]
                if bad:
                    dropped[tid] = f"downstream of excluded ticket(s): {', '.join(bad)}"
                    changed = True
    # Everything a decision ticket holds back, so the lead can say what an answer unblocks.
    def held_back(waiting):
        return sorted({*waiting} | {tid for tid in dropped
                                    if any(w in all_ancestors(tid, deps) for w in waiting)})

    decisions = [{"id": d, "title": info[d]["title"], "tags": info[d]["tags"], "outside_run": False,
                  "downstream": [tid for tid in held_back([d]) if tid != d]}
                 for d in decision_ids]
    for d, waiting in outside_decisions.items():
        decisions.append({"id": d, "title": title_and_body(d)[0], "tags": tag_list(meta(d)), "outside_run": True,
                          "downstream": held_back(waiting)})
    for tid, reason in dropped.items():
        excluded.append({"id": tid, "title": info[tid]["title"], "reason": reason})
        del info[tid]
    deps = {tid: [d for d in t["deps"]] for tid, t in info.items()}

    # Topological order with depth, for stats and a stable dispatch order.
    depth, order = {}, []

    def level(n):
        if n not in depth:
            depth[n] = 1 + max((level(d) for d in deps[n]), default=0)
        return depth[n]

    for tid in sorted(info, key=lambda i: (level(i), info[i]["priority"], i)):
        order.append(tid)
    widths = {}
    for d in depth.values():
        widths[d] = widths.get(d, 0) + 1

    # Transitive ancestors, to tell sequenced file overlaps from unsequenced ones.
    ancestors = {}

    def anc(n):
        if n not in ancestors:
            ancestors[n] = set()
            for d in deps[n]:
                ancestors[n] |= {d} | anc(d)
        return ancestors[n]

    by_file = {}
    for tid in order:
        for f in info[tid]["files"]:
            by_file.setdefault(f, []).append(tid)
    overlaps = []
    for f, tids in sorted(by_file.items()):
        loose = sorted({a for a in tids for b in tids
                        if a != b and b not in anc(a) and a not in anc(b)})
        if loose:
            overlaps.append({"file": f, "tickets": loose})

    parents = {t["parent"] for t in info.values()}
    shared_parent = next(iter(parents)) if len(parents) == 1 else None
    tickets = [{k: info[t][k] for k in ("id", "title", "priority", "parent", "tags", "deps", "has_ac", "ac_count", "files",
                                        "reviewed")}
               for t in order]
    dependents = {t["id"]: sum(1 for o in tickets if t["id"] in anc(o["id"])) for t in tickets}
    print(json.dumps({
        "mode": mode,
        "epic_id": epic_id,
        "shared_parent": shared_parent,
        "integration": integration_branch(mode, epic_id, shared_parent),
        "tickets": tickets,
        "excluded": excluded,
        "decisions": decisions,
        "decision_candidates": [{"id": t, "title": info[t]["title"], "phrase": info[t]["decision_phrase"]}
                                for t in order if info[t]["decision_phrase"]],
        "cycles": cycles,
        "overlaps": overlaps,
        "unannotated": [t["id"] for t in tickets if not t["files"]],
        "large": [{"id": t["id"], "title": t["title"], "ac_count": t["ac_count"], "dependents": dependents[t["id"]]}
                  for t in tickets if t["ac_count"] > LARGE_AC_COUNT],
        "setup_warnings": setup_warnings(),
        "stats": {
            "ready_now": sum(1 for t in tickets if not t["deps"]),
            "longest_chain": max(depth.values(), default=0),
            "max_width": max(widths.values(), default=0),
        },
    }, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
