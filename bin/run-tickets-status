#!/usr/bin/env python3
"""
Usage: run-tickets-status [--json | --archive] [run-id]
       run-tickets-status [--ticket <id>] [--watch <N>] [run-id]
       run-tickets-status --find-ticket <id>
       run-tickets-status --list

--archive writes the --json report to ~/.claude/run-history/<repo>/<run-id>.json.
Claude Code deletes the journal and agent logs after cleanupPeriodDays (30 by
default), so the archive is what later analysis of effort, tokens, and rework
across runs reads.

--ticket <id> limits the text report to its opening lines (the run, its timing,
MERGES HALTED when present) and that ticket's block. A ticket the run does not
hold prints "ticket <id> is not in run <run-id>" on stderr and exits 1.

--watch <N> clears the screen and prints the text report again every N seconds
(a whole number, 1 or more) until Ctrl-C, then exits 0. A round that cannot be
reported (no such run, not in a repository, the ticket not in the run, a
journal caught mid-write) prints why, and the next round tries again.

--find-ticket <id> says whether a /run-tickets run is working on the ticket. It
looks among this repo's runs (those --list shows) for the most recently
launched one whose state is running (a run whose workflow died without
finishing included) and which holds the ticket with an outcome other than
merged. Found: it prints {"run_id": "<run-id>", "state": "running"} and exits 0.
None: it prints nothing and exits 1. When it cannot tell (not in a git
repository, an unreadable run record, any other error) it prints the reason on
stderr and exits 2. A run record with no runId yet (the launch is still being
written) is skipped, and so is a run that has a record but no journal yet
(state launching).

A usage error exits 2.

Status snapshot of a /run-tickets workflow run, built from records rather than
agent prose:

  run record   <repo>/.worktrees/run-<stamp>.json, written by /run-tickets at
               launch: the workflow args (tickets, deps, branch) and the run id.
               The post-run cleanup deletes it.
  journal      the workflow's log of agent starts and typed results, found by
               run id under ~/.claude/projects/*/*/subagents/workflows/
  agent logs   agent-<id>.jsonl next to the journal; their first and last
               timestamps give each step's timing
  run metadata ~/.claude/projects/*/*/workflows/<run-id>.json, which Claude Code
               writes only when the run finishes: args, final result, start
               time and duration. Finished runs are found through it after the
               run record is gone. A run relaunched with resumeFromRunId keeps
               its id, so until it finishes again this file still holds the
               earlier pass; a journal written after it marks it stale.

With no run-id, reports the newest run for the current repo, running or
finished. --list shows recent runs for the repo. Because every source is found
by run id or repo path, this works from any Claude Code session, not only the
one that launched the run.
"""

import contextlib
import glob
import io
import json
import os
import re
import sys
import time
from datetime import datetime, timezone

USAGE = __doc__.strip().split("\n\n")[0]
PROJECTS = os.path.expanduser("~/.claude/projects")
HISTORY = os.path.expanduser("~/.claude/run-history")
LABEL_RE = re.compile(r"^(impl|ac|review|merge) (\S+)(?: r(\d+))?$")
STEP_NAMES = {"impl": "implementing", "ac": "verifying AC", "review": "reviewing", "merge": "merging"}
STEP_SHORT = {"impl": "impl", "ac": "AC", "review": "review", "merge": "merge"}
# The workflow was named run-tickets until 2026-10-05; finished-run metadata keeps the name it ran under.
WORKFLOW_NAMES = ("run-tickets-engine", "run-tickets")
NEVER = datetime.min.replace(tzinfo=timezone.utc)
# Cursor home, then clear the screen and its scrollback, as clear(1) does.
CLEAR = "\033[H\033[2J\033[3J"


def load_json(path, strict=False):
    """The file's JSON, or None when it is missing or cannot be read or parsed.

    strict raises instead for a file that exists but cannot be read or parsed.
    A file removed since it was listed is still None: its run was cleaned up.
    """
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as e:
        if strict:
            raise ValueError(f"cannot read {path}: {e}") from e
        return None


def repo_root():
    path = os.getcwd()
    while path != "/":
        if os.path.exists(os.path.join(path, ".git")):
            # Inside a linked worktree, .git is a file; step out to the main repo.
            if os.path.isfile(os.path.join(path, ".git")) and "/.worktrees/" in path:
                return path.split("/.worktrees/")[0]
            return path
        path = os.path.dirname(path)
    sys.exit("run-tickets-status: not inside a git repository")


def parse_ts(value):
    """ISO-8601 to an aware datetime; a time with no offset (the run record's) is local."""
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.astimezone()


def from_ms(ms):
    return datetime.fromtimestamp(ms / 1000, timezone.utc)


def fmt_dur(seconds):
    if seconds is None:
        return "?"
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    minutes = (seconds + 30) // 60
    return f"{minutes}m" if minutes < 60 else f"{minutes // 60}h{minutes % 60:02d}m"


def fmt_clock(dt):
    return dt.astimezone().strftime("%Y-%m-%d %H:%M") if dt else "?"


# ---------- finding runs ----------

def run_candidates(root, strict=False):
    """Every run of this repo keyed by run id: its run record and/or final metadata.

    strict raises on a run record that cannot be read or parsed rather than
    skipping it. Metadata files are skipped either way: they cover every repo
    and workflow, so one torn file elsewhere says nothing about this repo.
    """
    runs = {}
    for path in glob.glob(os.path.join(root, ".worktrees", "run-*.json")):
        rec = load_json(path, strict)
        if rec and rec.get("runId"):
            runs.setdefault(rec["runId"], {})["record"] = rec
            runs[rec["runId"]]["mtime"] = os.path.getmtime(path)
    for path in glob.glob(os.path.join(PROJECTS, "*", "*", "workflows", "wf_*.json")):
        meta = load_json(path)
        if not meta or meta.get("workflowName") not in WORKFLOW_NAMES:
            continue
        if (meta.get("args") or {}).get("repoRoot") != root and meta.get("runId") not in runs:
            continue
        entry = runs.setdefault(meta["runId"], {})
        entry["final"] = meta
        entry["mtime"] = max(entry.get("mtime", 0), os.path.getmtime(path))
    return runs


def find_run(run_id):
    runs = run_candidates(repo_root())
    if run_id:
        if run_id not in runs:
            # Not this repo's, or its record is gone: look the metadata up by id alone.
            for path in glob.glob(os.path.join(PROJECTS, "*", "*", "workflows", f"{run_id}.json")):
                runs[run_id] = {"final": load_json(path), "mtime": os.path.getmtime(path)}
        if run_id not in runs:
            sys.exit(f"run-tickets-status: no run {run_id} (no run record in .worktrees/ and no finished-run metadata)")
        return run_id, runs[run_id]
    if not runs:
        sys.exit("run-tickets-status: no /run-tickets runs found for this repo")
    newest = max(runs, key=lambda r: runs[r]["mtime"])
    return newest, runs[newest]


def find_journal(run_id):
    matches = glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "workflows", run_id, "journal.jsonl"))
    return matches[0] if matches else None


def read_events(journal_path):
    """The journal's events in order; none before the workflow has written one."""
    if not journal_path:
        return []
    with open(journal_path) as f:
        return [json.loads(line) for line in f if line.strip()]


# The journal's last write comes before the metadata is written; allow for clock and filesystem slack.
STALE_AFTER_SECONDS = 5


def superseded(final, journal_path):
    """True when the finished-run metadata predates the journal's last write.

    Relaunching with resumeFromRunId keeps the run id and appends to the same
    journal, but Claude Code rewrites the metadata only when the relaunched run
    finishes. Until then the metadata's result is the earlier pass's.
    """
    if not final or not journal_path:
        return False
    if final.get("timestamp"):
        written = parse_ts(final["timestamp"]).timestamp()
    elif final.get("startTime") and final.get("durationMs") is not None:
        written = (final["startTime"] + final["durationMs"]) / 1000
    else:
        return False
    try:
        return os.path.getmtime(journal_path) > written + STALE_AFTER_SECONDS
    except OSError:
        return False


def load_run(run_id, entry):
    """A run's args, final metadata, run record and journal path, and its state.

    The report and --find-ticket both take the state from here, so they never
    disagree on whether a run is still running.
    """
    final, record = entry.get("final"), entry.get("record")
    args = (final or {}).get("args") or (record or {}).get("args") or {}
    journal_path = find_journal(run_id)
    if superseded(final, journal_path):
        final = None  # an earlier pass's result; the relaunched run is still going
    state = "finished" if final is not None else ("running" if journal_path else "launching")
    return {"final": final, "record": record, "args": args, "journal_path": journal_path,
            "result": (final or {}).get("result"), "state": state}


def launch_time(final, record):
    """When the run started: the finished run's start, else the run record's launch time."""
    if final and final.get("startTime"):
        return from_ms(final["startTime"])
    if record and record.get("launched"):
        return parse_ts(record["launched"])
    return None


def running_run_holding(ticket_id):
    """The id of the most recently launched running run that holds the ticket unmerged, or None.

    This is the rule for "the ticket is in a running run": a run of this repo
    whose state is running and which holds the ticket with an outcome other than
    merged. Raises when it cannot tell.
    """
    held = []
    for run_id, entry in run_candidates(repo_root(), strict=True).items():
        run = load_run(run_id, entry)
        # Only a run holding the ticket needs its journal read, so a torn journal elsewhere cannot fail the lookup.
        if run["state"] != "running" or ticket_id not in {t["id"] for t in run["args"].get("tickets", [])}:
            continue
        tickets, _, _ = ticket_states(run["args"], run["result"], read_events(run["journal_path"]))
        if any(t["id"] == ticket_id and t["outcome"] != "merged" for t in tickets):
            held.append((launch_time(run["final"], run["record"]) or NEVER, run_id))
    return max(held)[1] if held else None


def failure(e):
    """One line naming an error that stopped a lookup or a round."""
    return f"run-tickets-status: {type(e).__name__}: {e}"


def find_ticket(ticket_id):
    """--find-ticket's exit code.

    0 after printing the running run that holds the ticket, 1 when none does,
    and 2 after printing the reason on stderr when the lookup fails.
    """
    try:
        run_id = running_run_holding(ticket_id)
    except SystemExit as e:  # repo_root: not inside a git repository
        print(e.code, file=sys.stderr)
        return 2
    except Exception as e:
        print(failure(e), file=sys.stderr)
        return 2
    if run_id is None:
        return 1
    print(json.dumps({"run_id": run_id, "state": "running"}))
    return 0


# ---------- ticket state ----------

def ticket_states(args, result, events):
    caps = {"acFails": 3, "qrReworks": 3, "conflicts": 3, "gateFails": 2, **(args.get("caps") or {})}

    def fresh(t):
        return {"id": t["id"], "title": t["title"], "deps": t["deps"], "has_ac": t["has_ac"],
                "files": t.get("files") or [], "decision": t.get("decision"),
                "impl_rounds": 0, "ac_fails": 0, "review_rounds": 0, "reworks": 0, "conflicts": 0,
                "gate_fails": 0, "human_checks": [],
                "active": None, "last": None, "outcome": None, "sha": "", "findings": [], "agents": [],
                "results": {}, "src_lines_changed": None, "prior_fixed": 0, "prior_total": 0}

    tickets = {t["id"]: fresh(t) for t in args.get("tickets", [])}
    labels, integration, integration_agent = {}, None, None

    for ev in events:
        if ev["type"] == "launched":
            # Defensive: a resumed run appends to the same journal without a new
            # "launched" marker today, but if one appears, rebuild from there.
            tickets = {t["id"]: fresh(t) for t in args.get("tickets", [])}
            labels, integration, integration_agent = {}, None, None
            continue
        if ev["type"] == "started":
            labels[ev["agentId"]] = ev.get("label", "")
            m = LABEL_RE.match(ev.get("label", ""))
            if m and m.group(2) in tickets:
                t = tickets[m.group(2)]
                t["active"] = (m.group(1), int(m.group(3) or 1))
                t["outcome"] = None
                t["agents"].append((m.group(1), ev["agentId"]))
            elif ev.get("label") == "integration check":
                integration, integration_agent = {"status": "running"}, ev["agentId"]
            continue
        if ev["type"] != "result":
            continue
        label = labels.get(ev.get("agentId"), "")
        res = ev.get("result") or {}
        if label == "integration check":
            integration = res
            continue
        m = LABEL_RE.match(label)
        if not m or m.group(2) not in tickets:
            continue
        kind, t = m.group(1), tickets[m.group(2)]
        t["active"] = None
        t["last"] = (kind, res)
        t["results"][ev["agentId"]] = res
        if kind == "impl":
            t["impl_rounds"] += 1
            if isinstance(res.get("src_lines_changed"), int):
                t["src_lines_changed"] = res["src_lines_changed"]
            if res.get("status") != "done":
                t["outcome"] = "blocked"
        elif kind == "ac":
            if res.get("verdict") == "FAIL":
                t["ac_fails"] += 1
            elif res.get("verdict") == "PASS":
                t["human_checks"] = [f"{c.get('criterion')}: {c['human_check']}"
                                     for c in res.get("criteria") or [] if c.get("human_check")]
            if res.get("verdict") == "ERROR" or t["ac_fails"] >= caps["acFails"]:
                t["outcome"] = "blocked"
        elif kind == "review":
            t["review_rounds"] += 1
            t["findings"] += res.get("tickets_created", [])  # runs from before the backlog split
            t["findings"] += [f"{f['id']} ({'noted' if f.get('action') == 'noted' else f.get('parent', '?')})"
                              for f in res.get("filed", [])]
            prior = res.get("prior_findings") or []
            t["prior_total"] += len(prior)
            t["prior_fixed"] += sum(1 for p in prior if p.get("fixed"))
            if res.get("verdict") == "REWORK" and res.get("findings"):
                t["reworks"] += 1
            if res.get("verdict") == "ERROR" or t["reworks"] >= caps["qrReworks"]:
                t["outcome"] = "blocked"
        elif kind == "merge":
            if res.get("result") == "merged":
                t["outcome"], t["sha"] = "merged", res.get("sha", "")
            elif res.get("result") == "conflict":
                t["conflicts"] += 1
                if t["conflicts"] >= caps["conflicts"]:
                    t["outcome"] = "blocked"
            elif res.get("result") == "gate_fail":
                t["gate_fails"] += 1
                if t["gate_fails"] >= caps["gateFails"]:
                    t["outcome"] = "blocked"
            else:
                t["outcome"] = "blocked"

    # A finished run's result is authoritative for outcomes and reasons.
    final = {r["id"]: r for r in (result or {}).get("tickets", [])}
    for tid, t in tickets.items():
        if tid in final:
            t["outcome"] = final[tid]["outcome"]
            t["reason"] = final[tid].get("reason", "")
    return list(tickets.values()), integration, integration_agent


def describe(t, tickets_by_id, finished):
    if t["outcome"] == "merged":
        return f"merged {t['sha']}".strip()
    if t["outcome"] in ("blocked", "stalled"):
        return t["outcome"].upper() + (f": {t['reason']}" if t.get("reason") else "")
    if t["active"]:
        kind, rnd = t["active"]
        return STEP_NAMES[kind] + (f" (round {rnd})" if rnd > 1 else "")
    if t["last"]:
        # The step just finished and the next agent has not started yet.
        kind, res = t["last"]
        verdict = res.get("verdict") or res.get("result") or res.get("status")
        if kind == "review" and verdict in ("CLEAN", "FINDINGS"):
            return f"waiting to merge (review {verdict}; merges run one at a time)"
        nxt = {"impl": "AC verification" if t["has_ac"] else "review", "ac": "review" if verdict == "PASS" else "rework",
               "review": "rework",
               "merge": "gate failure fix" if verdict == "gate_fail" else "conflict resolution"}[kind]
        return f"starting {nxt} (last: {kind} {verdict})"
    waiting = [d for d in t["deps"] if tickets_by_id.get(d, {}).get("outcome") != "merged"]
    if finished:
        return "never started"
    if waiting:
        return f"waiting on {', '.join(waiting)}"
    # Shared files never hold a ticket back, so a ready ticket only waits for a slot.
    return "queued for a worktree slot"


# ---------- timing ----------

def _first_timestamp(lines):
    for line in lines:
        try:
            ts = json.loads(line).get("timestamp")
        except (json.JSONDecodeError, AttributeError):
            continue
        if ts:
            return parse_ts(ts)
    return None


def agent_span(run_dir, agent_id):
    """(start, end) of one agent, from the first and last timestamps in its log.

    Reads only the two ends of the file: transcripts run to megabytes. The
    chunk boundaries can cut a line in half, and those halves fail to parse
    and are skipped.
    """
    path = os.path.join(run_dir, f"agent-{agent_id}.jsonl")
    try:
        with open(path, "rb") as f:
            head = f.read(262144).decode("utf-8", "replace").splitlines()
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 262144))
            tail = f.read().decode("utf-8", "replace").splitlines()
        mtime = datetime.fromtimestamp(os.path.getmtime(path), timezone.utc)
    except OSError:
        return None
    start = _first_timestamp(head)
    end = _first_timestamp(reversed(tail)) or mtime
    return (start, end) if start else None


def agent_effort(run_dir, agent_id):
    """(effort, model) one agent ran at, from the first response line of its log.

    Token counts are deliberately not read here: most response lines are
    logged mid-stream with a partial usage count, so summing them undercounts.
    The finished-run metadata has the runtime's own per-agent totals instead.
    """
    path = os.path.join(run_dir, f"agent-{agent_id}.jsonl")
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"type":"assistant"' not in line:
                    continue
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    continue
                msg = ev.get("message") if isinstance(ev.get("message"), dict) else {}
                return ev.get("effort"), msg.get("model")
    except OSError:
        pass
    return None, None


def progress_by_agent(final):
    """Per-agent runtime totals (tokens, tool calls) from the finished-run metadata, keyed by agent id."""
    return {p["agentId"]: p for p in (final or {}).get("workflowProgress") or []
            if p.get("type") == "workflow_agent" and p.get("agentId")}


def step_records(t, run_dir, progress):
    """One record per agent the ticket ran: what it was, how hard it thought, what it cost, what it said."""
    steps, rounds = [], {}
    for kind, aid in t["agents"]:
        rounds[kind] = rounds.get(kind, 0) + 1
        res = t["results"].get(aid) or {}
        span = agent_span(run_dir, aid) if run_dir else None
        effort, model = agent_effort(run_dir, aid) if run_dir else (None, None)
        prog = progress.get(aid) or {}
        rec = {"step": kind, "round": rounds[kind], "agent_id": aid, "effort": effort,
               "model": model or prog.get("model"),
               "started": span[0].astimezone().isoformat(timespec="seconds") if span else None,
               "seconds": (span[1] - span[0]).total_seconds() if span else None,
               # Runtime totals, input included; only finished runs have them.
               "tokens": prog.get("tokens"), "tool_calls": prog.get("toolCalls"),
               "result": res.get("verdict") or res.get("status") or res.get("result")}
        if kind == "impl" and isinstance(res.get("src_lines_changed"), int):
            rec["src_lines_changed"] = res["src_lines_changed"]
        if kind == "review":
            rec["findings"] = len(res.get("findings") or [])
            prior = res.get("prior_findings") or []
            rec["prior_findings"] = {"fixed": sum(1 for p in prior if p.get("fixed")), "total": len(prior)}
        steps.append(rec)
    return steps


def dependents_of(tickets):
    """Transitive dependents per ticket, as run-tickets-plan and the workflow count them."""
    anc = {}
    for t in tickets:  # topological order
        anc[t["id"]] = set().union(*[{d} | anc.get(d, set()) for d in t["deps"]])
    return {t["id"]: sum(1 for o in tickets if t["id"] in anc[o["id"]]) for t in tickets}


def fmt_tokens(n):
    return f"{n / 1_000_000:.1f}M" if n >= 1_000_000 else f"{round(n / 1000)}k" if n >= 1000 else str(n)


def ticket_timing(t, run_dir, run_start, now):
    steps, first, last, running_for = {}, None, None, None
    for i, (kind, aid) in enumerate(t["agents"]):
        span = agent_span(run_dir, aid) if run_dir else None
        if not span:
            continue
        start, end = span
        if t["active"] and i == len(t["agents"]) - 1:
            end = now
            running_for = (now - start).total_seconds()
        steps[kind] = steps.get(kind, 0) + (end - start).total_seconds()
        first = min(first, start) if first else start
        last = max(last, end) if last else end
    if not first:
        return None
    wall = (last - first).total_seconds()
    return {
        "began_after_launch": (first - run_start).total_seconds() if run_start else None,
        "wall": wall,
        "steps": steps,
        "waiting": max(0, wall - sum(steps.values())),
        "running_for": running_for,
    }


def timing_line(tm, outcome):
    parts = [f"{STEP_SHORT[k]} {fmt_dur(tm['steps'][k])}" for k in ("impl", "ac", "review", "merge") if k in tm["steps"]]
    if tm["waiting"] >= 30:
        parts.append(f"waiting {fmt_dur(tm['waiting'])}")
    span = {"merged": "start to merge", "blocked": "start to block"}.get(outcome, "so far")
    # A late start means the ticket waited on a dependency or a free slot.
    began = f", began {fmt_dur(tm['began_after_launch'])} after launch" if (tm["began_after_launch"] or 0) >= 30 else ""
    running = f"; current step running {fmt_dur(tm['running_for'])}" if tm["running_for"] is not None else ""
    return f"time: {fmt_dur(tm['wall'])} {span}{began} ({', '.join(parts)}){running}"


def fmt_start(dt, day):
    """Local clock time, with the date when it falls on another day than the run's start."""
    local = dt.astimezone()
    return local.strftime("%H:%M") if local.date() == day else local.strftime("%m-%d %H:%M")


def started_line(t, run_start, now):
    """Each agent the ticket ran, in order: when it started and how long it took or has run."""
    day = run_start.astimezone().date() if run_start else None

    def one(i, s):
        name = STEP_SHORT[s["step"]] + (f" r{s['round']}" if s["round"] > 1 else "")
        if not s.get("started"):
            return f"{name} ?"
        start = parse_ts(s["started"])
        if t["active"] and i == len(t["steps"]) - 1:
            took = f"running {fmt_dur((now - start).total_seconds())}"
        else:
            took = fmt_dur(s["seconds"])
        return f"{name} {fmt_start(start, day)} ({took})"
    return "started: " + ", ".join(one(i, s) for i, s in enumerate(t["steps"]))


def effort_line(t):
    def one(s):
        name = STEP_SHORT[s["step"]] + (f" r{s['round']}" if s["round"] > 1 else "")
        cost = f" {fmt_tokens(s['tokens'])}" if s.get("tokens") else ""
        # Haiku takes no effort setting, so its log has none.
        return f"{name} {s.get('effort') or '-'}{cost}"
    size = f"src lines {t['src_lines_changed']}" if t["src_lines_changed"] is not None else "src lines ?"
    fixed = (f"; previous findings fixed {t['prior_findings']['fixed']}/{t['prior_findings']['total']}"
             if t["prior_findings"]["total"] else "")
    return f"effort: {', '.join(one(s) for s in t['steps'])}; {size}, dependents {t['dependents']}{fixed}"


def archive(report):
    """Keep the report past Claude Code's transcript cleanup, one file per run."""
    root = repo_root()
    folder = os.path.join(HISTORY, os.path.basename(root))
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, f"{report['run_id']}.json")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"repo": root, **report}, f, indent=2, default=str)
    os.replace(tmp, path)
    return path


# ---------- output ----------

def list_runs():
    runs = run_candidates(repo_root())
    if not runs:
        print("no /run-tickets runs found for this repo")
        return
    rows = []
    for run_id, entry in runs.items():
        final, record = entry.get("final"), entry.get("record")
        args = (final or {}).get("args") or (record or {}).get("args") or {}
        if superseded(final, find_journal(run_id)):
            final = None
        tickets = ((final or {}).get("result") or {}).get("tickets") or []
        merged = sum(1 for t in tickets if t.get("outcome") == "merged")
        if final and final.get("startTime"):
            started = from_ms(final["startTime"])
            summary = f"finished in {fmt_dur(final.get('durationMs', 0) / 1000)}, merged {merged}/{len(args.get('tickets', []))}"
        else:
            started = parse_ts(record["launched"]) if record and record.get("launched") else None
            summary = f"not finished, {len(args.get('tickets', []))} tickets"
        ids = " ".join(t["id"] for t in args.get("tickets", []))
        rows.append((started or datetime.min.replace(tzinfo=timezone.utc), run_id, summary, ids))
    for started, run_id, summary, ids in sorted(rows, reverse=True)[:15]:
        print(f"{run_id}  {fmt_clock(started)}  {summary}  [{ids}]")


def agent_seconds_by_step(tickets, integration_span):
    """Agent time by step across the run: where the hours actually went."""
    totals = {}
    for t in tickets:
        for kind, secs in ((t["timing"] or {}).get("steps") or {}).items():
            totals[kind] = totals.get(kind, 0) + secs
    if integration_span:
        totals["integration check"] = (integration_span[1] - integration_span[0]).total_seconds()
    return totals


def tokens_by_step(tickets):
    tokens = {}
    for t in tickets:
        for s in t["steps"]:
            tokens[s["step"]] = tokens.get(s["step"], 0) + (s.get("tokens") or 0)
    return tokens


def last_agent_activity(run_dir):
    """Agent transcripts are appended on every tool call, so the newest one is
    the best "is anything still happening" signal."""
    stamps = [os.path.getmtime(p) for p in glob.glob(os.path.join(run_dir, "agent-*.jsonl"))] if run_dir else []
    return datetime.fromtimestamp(max(stamps), timezone.utc).astimezone() if stamps else None


def end_time(final, run_start):
    """When the finished run ended; falsy while it runs."""
    return run_start and final and final.get("durationMs") and \
        from_ms(final["startTime"] + final["durationMs"])


def iso_seconds(dt):
    return dt.isoformat(timespec="seconds") if dt else None


def build_report(run_id, run, tickets, integration, integration_agent):
    """The report --json prints, and what the text form needs besides it."""
    final, record, args, journal_path = (run[k] for k in ("final", "record", "args", "journal_path"))
    result = run["result"] or {}
    run_dir = os.path.dirname(journal_path) if journal_path else None
    by_id = {t["id"]: t for t in tickets}
    for t in tickets:
        t["status"] = describe(t, by_id, final is not None)

    now = datetime.now(timezone.utc)
    run_start = launch_time(final, record)
    run_end = end_time(final, run_start)

    dependents = dependents_of(args.get("tickets", []))
    progress = progress_by_agent(final)
    for t in tickets:
        t["timing"] = ticket_timing(t, run_dir, run_start, now)
        t["steps"] = step_records(t, run_dir, progress)
        t["dependents"] = dependents.get(t["id"], 0)
        t["prior_findings"] = {"fixed": t["prior_fixed"], "total": t["prior_total"]}
    integration_span = agent_span(run_dir, integration_agent) if run_dir and integration_agent else None
    totals = agent_seconds_by_step(tickets, integration_span)
    tokens = tokens_by_step(tickets)
    last_activity = last_agent_activity(run_dir)

    report = {
        "run_id": run_id,
        "state": run["state"],
        "started": iso_seconds(run_start),
        "ended": iso_seconds(run_end),
        "duration_seconds": ((run_end or now) - run_start).total_seconds() if run_start else None,
        "last_activity": iso_seconds(last_activity),
        "integration_branch": args.get("integrationBranch"),
        "merge_halted": result.get("mergeHalted"),
        "integration_check": integration,
        "agent_seconds_by_step": totals,
        "tokens_by_step": tokens,  # runtime totals, input included; empty until the run finishes
        # The effort thresholds the run used; absent for runs from before they existed.
        "policy": result.get("policy"),
        "tickets": [{k: t[k] for k in ("id", "title", "status", "outcome", "deps", "has_ac", "dependents",
                                       "src_lines_changed", "impl_rounds", "ac_fails", "review_rounds",
                                       "reworks", "conflicts", "gate_fails", "human_checks", "decision",
                                       "prior_findings", "findings", "timing", "steps")}
                    for t in tickets],
    }
    view = {"run_start": run_start, "run_end": run_end, "now": now, "last_activity": last_activity,
            "integration": integration, "integration_span": integration_span, "totals": totals, "tokens": tokens}
    return report, view


def print_header(report, tickets, view):
    """The text report's opening lines: the run, its timing, and MERGES HALTED when present."""
    run_start, run_end = view["run_start"], view["run_end"]
    merged = sum(1 for t in tickets if t["outcome"] == "merged")
    print(f"run-tickets {report['run_id']}  [{report['state']}]  branch {report['integration_branch']}")
    if run_end:
        timing = f"launched {fmt_clock(run_start)}, finished {fmt_clock(run_end)} ({fmt_dur(report['duration_seconds'])})"
    else:
        timing = (f"launched {fmt_clock(run_start)}, running {fmt_dur(report['duration_seconds'])}" if run_start
                  else "launch time unknown")
        timing += f"  last agent activity {fmt_clock(view['last_activity'])}"
    print(f"{timing}  merged {merged}/{len(tickets)}")
    if report["merge_halted"]:
        print(f"MERGES HALTED: {report['merge_halted']}")
    print()


def print_ticket(t, width, run_start, now):
    """One ticket's block of the text report."""
    counts = (f"agent runs: impl {t['impl_rounds']}, AC {t['ac_fails']} failed, "
              f"review {t['review_rounds']}, merge conflicts {t['conflicts']}"
              + (f", gate fails {t['gate_fails']}" if t["gate_fails"] else ""))
    print(f"  {t['id']:<{width}}  {t['status']}")
    print(f"  {'':<{width}}  {t['title']}  ({counts})")
    if t["decision"]:
        print(f"  {'':<{width}}  owner decision: {t['decision']}")
    for check in t["human_checks"]:
        print(f"  {'':<{width}}  needs a person to check: {check}")
    if t["timing"]:
        print(f"  {'':<{width}}  {timing_line(t['timing'], t['outcome'])}")
    if t["steps"]:
        print(f"  {'':<{width}}  {started_line(t, run_start, now)}")
        print(f"  {'':<{width}}  {effort_line(t)}")
    if t["findings"]:
        print(f"  {'':<{width}}  findings filed: {', '.join(t['findings'])}")


def print_totals(view):
    """The text report's closing lines: the integration check, and where agent time and tokens went."""
    integration, integration_span, run_start = view["integration"], view["integration_span"], view["run_start"]
    totals, tokens = view["totals"], view["tokens"]
    if integration:
        took = (f" (started {fmt_start(integration_span[0], run_start.astimezone().date() if run_start else None)}, "
                f"{fmt_dur(totals['integration check'])})" if integration_span else "")
        print(f"\nintegration check: {integration.get('status')}{took}"
              + (f", {integration['summary']}" if integration.get("summary") else ""))
    if totals:
        order = ["impl", "ac", "review", "merge", "integration check"]
        print("\nagent time by step: " + ", ".join(f"{STEP_SHORT.get(k, k)} {fmt_dur(totals[k])}" for k in order if k in totals)
              + f"  (sum {fmt_dur(sum(totals.values()))}; steps of different tickets overlap)")
    if any(tokens.values()):
        print("tokens by step: " + ", ".join(f"{STEP_SHORT[k]} {fmt_tokens(tokens[k])}"
                                                    for k in ("impl", "ac", "review", "merge") if tokens.get(k)))


def print_text(report, tickets, view, only=None):
    """The text report; with only, its opening lines and that ticket's block."""
    print_header(report, tickets, view)
    width = max(len(t["id"]) for t in tickets) if tickets else 4
    for t in tickets:
        if only in (None, t["id"]):
            print_ticket(t, width, view["run_start"], view["now"])
    if only is None:
        print_totals(view)


def show_report(opts):
    """One report: the text form (whole, or one ticket's part of it), --json, or --archive."""
    run_id, entry = find_run(opts["run_id"])
    run = load_run(run_id, entry)
    tickets, integration, integration_agent = ticket_states(run["args"], run["result"], read_events(run["journal_path"]))
    if opts["ticket"] is not None and opts["ticket"] not in {t["id"] for t in tickets}:
        sys.exit(f"ticket {opts['ticket']} is not in run {run_id}")
    report, view = build_report(run_id, run, tickets, integration, integration_agent)
    if opts["archive"]:
        path = archive(report)
        print(f"archived {run_id} to {path}")
    elif opts["json"]:
        print(json.dumps(report, indent=2, default=str))
    else:
        print_text(report, tickets, view, opts["ticket"])


def watch(seconds, show):
    """Clear the screen and print a fresh round of show() every `seconds` until Ctrl-C."""
    try:
        while True:
            out = io.StringIO()
            with contextlib.redirect_stdout(out):
                try:
                    show()
                except SystemExit as e:
                    # No such run, not in a repository, or the ticket not in the run.
                    print(e.code)
                except Exception as e:
                    # A journal caught mid-write, say: the next round reads it again.
                    print(failure(e))
            sys.stdout.write(CLEAR + out.getvalue())
            sys.stdout.flush()
            time.sleep(seconds)
    except KeyboardInterrupt:
        pass


# ---------- arguments ----------

BOOL_FLAGS = ("--list", "--json", "--archive")
VALUE_FLAGS = ("--find-ticket", "--ticket", "--watch")


def usage_error(msg):
    """Exit 2 with the problem on stderr's first line and the usage after it."""
    print(f"run-tickets-status: {msg}\n{USAGE}", file=sys.stderr)
    sys.exit(2)


def watch_seconds(value):
    try:
        seconds = int(value)
    except ValueError:
        seconds = 0
    if seconds < 1:
        usage_error(f"--watch needs a whole number of seconds, 1 or more, not {value}")
    return seconds


def read_args(argv):
    """Each option by name (find_ticket, ticket, watch, list, json, archive), and the run id.

    A flag's value is read with its flag, so it is never taken for the run id.
    """
    opts = {name: None for name in ("find_ticket", "ticket", "watch", "list", "json", "archive", "run_id")}
    it = iter(argv)
    for arg in it:
        name = arg[2:].replace("-", "_")
        if arg in BOOL_FLAGS:
            opts[name] = True
        elif arg in VALUE_FLAGS:
            value = next(it, None)
            if value is None or value.startswith("--"):
                usage_error(f"{arg} needs a value")
            opts[name] = value
        elif arg.startswith("--"):
            usage_error(f"unknown option {arg}")
        elif opts["run_id"] is None:
            opts["run_id"] = arg
        else:
            usage_error(f"one run id at most, not {opts['run_id']} and {arg}")
    return opts


def parse_args(argv):
    """The options read_args finds, once they are known to go together."""
    opts = read_args(argv)
    if opts["watch"] is not None:
        opts["watch"] = watch_seconds(opts["watch"])
    if opts["find_ticket"] is not None and sum(v is not None for v in opts.values()) > 1:
        usage_error("--find-ticket takes no run id and no other option")
    if (opts["ticket"] is not None or opts["watch"] is not None) and (opts["list"] or opts["json"] or opts["archive"]):
        usage_error("--ticket and --watch are for the text report, not --list, --json or --archive")
    return opts


def main(argv):
    opts = parse_args(argv)
    if opts["list"]:
        list_runs()
    elif opts["find_ticket"] is not None:
        sys.exit(find_ticket(opts["find_ticket"]))
    elif opts["watch"] is not None:
        watch(opts["watch"], lambda: show_report(opts))
    else:
        show_report(opts)


if __name__ == "__main__":
    main(sys.argv[1:])
